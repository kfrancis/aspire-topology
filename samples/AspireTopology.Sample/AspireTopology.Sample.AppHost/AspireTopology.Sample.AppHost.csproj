<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>aspire-topology-sample</UserSecretsId>
    <!-- The globally installed Aspire CLI runs "aspire do topology"; the bundle is not needed here. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspireTopology.Sample.Api\AspireTopology.Sample.Api.csproj" />
    <ProjectReference Include="..\AspireTopology.Sample.Web\AspireTopology.Sample.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AspireTopology.Hosting\AspireTopology.Hosting.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
