<Project Sdk="Aspire.AppHost.Sdk/13.5.3">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>aspire-topology-sample</UserSecretsId>
    <!--
      false brings the DCP orchestration and dashboard binaries into the project as packages, so the
      built AppHost runs standalone. true instead bakes in paths resolved from an installed Aspire
      CLI, which Visual Studio's F5 (commandName: Project) cannot rely on: it launches the built
      executable directly rather than through the CLI, and fails with missing CliPath/DashboardPath.
      ASPIRE010 warns that some CLI-bundle features are unavailable; running the app is not one.
    -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspireTopology.Sample.Api\AspireTopology.Sample.Api.csproj" />
    <ProjectReference Include="..\AspireTopology.Sample.Web\AspireTopology.Sample.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AspireTopology.Hosting\AspireTopology.Hosting.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
